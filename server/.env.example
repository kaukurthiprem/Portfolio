# MySQL database connection (never put real secrets in frontend code or GitHub)
PORT=5000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portfolio_user
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=prem_portfolio

# Comma-separated frontend origins. Local Vite is included by default.
FRONTEND_ORIGINS=http://localhost:5173

# Optional email notification (SMTP). Database saving works without these.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_TO=kasukurthiprem1835@gmail.com
NOTIFICATION_FROM=
